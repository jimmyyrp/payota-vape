# =============================================================
# VAPE STORE - ENVIRONMENT VARIABLES
# =============================================================

# --- CLIENT SIDE (Browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- SERVER SIDE (Service Role) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# --- SUPABASE AUTH JWKS ---
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- DATABASE (Migrations via npm run db:migrate) ---
# Format: postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# CATATAN: jika password mengandung karakter khusus seperti ?, *, atau #,
# URL-encode dulu (contoh: ? menjadi %3F) agar tidak memecah parsing URI.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CATATAN: endpoint /api/maintenance dan /api/revalidate TIDAK lagi memakai
# MAINTENANCE_SECRET / REVALIDATE_SECRET. Akses kini divisi lewat peran
# (admin/developer) yang diverifikasi oleh database (tabel admin_sessions).
# Cukup login sebagai staf lalu klik tombol di panel Developer/Pengaturan.

# --- SEO (opsional) ---
NEXT_PUBLIC_SITE_URL=https://your-site-url.app